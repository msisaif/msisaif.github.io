<template>
    <header class="hero" id="top">
        <div class="wrap">
            <div class="hero-grid">
                <div>
                    <p class="kicker">{{ data.site.location }}</p>
                    <h1>{{ data.hero.name }}</h1>
                    <p class="role"><b>{{ data.hero.roleBold }}</b> · {{ data.hero.roleRest }} <a class="ext" href="{{ data.hero.roleLinkHref }}" target="_blank" rel="noopener" aria-label="{{ data.hero.roleLinkLabel }} (opens msilabs.github.io)">{{ data.hero.roleLinkLabel }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a></p>
                    <p class="lead">{{ data.hero.leadLine }}<br><em>{{ data.hero.leadEmphasis }}</em></p>
                    <div class="chips">
                        <template for="chip in data.hero.chips">
                            <span class="chip {{ chip.highlight ? 'hl' : '' }}">{{ chip.label }}</span>
                        </template>
                    </div>
                    <div class="btns">
                        <a class="btn primary" href="{{ data.links.linkedin }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                            LinkedIn <span class="handle">{{ data.links.linkedinHandle }}</span>
                        </a>
                        <a class="btn" href="{{ data.links.github }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"/></svg>
                            GitHub <span class="handle">{{ data.links.githubHandle }}</span>
                        </a>
                    </div>
                </div>

                <aside class="card-id" aria-label="Profile summary">
                    <img class="photo" src="/photo.jpg" alt="{{ data.hero.photoAlt }}" width="116" height="116">
                    <div class="term">
                        <span class="c">// whoami</span><br>
                        <template for="row in data.hero.whoami">
                            <span class="k">{{ row.key }}</span>: <span class="s">"{{ row.value }}"</span><br>
                        </template>
                        <span class="k">stack</span>: [<template for="(item, i) in data.hero.stack"><template if="i > 0">, </template><span class="s">"{{ item }}"</span></template>]
                    </div>
                </aside>
            </div>

            <div class="stats">
                <template for="stat in data.hero.stats">
                    <div class="stat"><b>{{ stat.value }}</b><span>{{ stat.label }}</span></div>
                </template>
            </div>
        </div>
    </header>
</template>

<style>
    .hero {
        padding: 84px 0 64px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.35fr 0.9fr;
        gap: 48px;
        align-items: center;
    }

    @media (max-width: 860px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }
    }

    .kicker {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--accent-ink);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 14px;
    }

    h1 {
        font-size: clamp(36px, 5.4vw, 56px);
        line-height: 1.08;
        margin: 0 0 10px;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .role {
        font-size: 18px;
        color: var(--muted);
        margin: 0 0 22px;
    }

    .role a {
        color: var(--accent-tint);
        text-decoration: none;
    }

    .role a:hover {
        text-decoration: underline;
    }

    .role .ext {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .role .ext svg {
        width: 14px;
        height: 14px;
    }

    .role b {
        color: var(--text);
        font-weight: 600;
    }

    .lead {
        font-size: clamp(20px, 2.4vw, 26px);
        line-height: 1.35;
        font-weight: 700;
        margin: 0 0 24px;
    }

    .lead em {
        font-style: normal;
        color: var(--accent-ink);
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 28px;
    }

    .chip {
        font-size: 13px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--bg2);
        color: var(--text);
    }

    @media (max-width: 400px) {
        .chip {
            padding: 6px 10px;
            border-radius: 16px;
            font-size: 12px;
        }
    }

    .chip.hl {
        border-color: var(--accent-line);
        background: var(--accent-soft);
        color: var(--accent-tint);
    }

    .handle {
        font-weight: 500;
        opacity: 0.8;
    }

    .card-id {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 22px;
        position: relative;
    }

    .card-id .photo {
        width: 116px;
        height: 116px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--accent);
        display: block;
        margin-bottom: 16px;
    }

    .term {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--muted);
        line-height: 1.9;
    }

    .term .k {
        color: var(--term-key);
    }

    .term .s {
        color: var(--accent-tint);
    }

    .term .c {
        color: var(--dim);
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 56px;
    }

    @media (max-width: 700px) {
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .stat {
        background: var(--bg2);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px 18px;
    }

    .stat b {
        display: block;
        font-size: 28px;
        font-weight: 800;
        color: var(--accent-ink);
        line-height: 1.1;
    }

    .stat span {
        font-size: 13px;
        color: var(--muted);
    }
</style>
