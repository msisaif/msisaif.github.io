<template>
    <nav>
        <div class="wrap">
            <a class="brand" href="#top">md<span>.</span>saiful<span>.</span>islam</a>
            <div class="right">
                <div class="links">
                    <template for="link in data.nav">
                        <a href="{{ link.href }}">{{ link.label }}</a>
                    </template>
                </div>
                <div class="tools">
                    <div class="picker">
                        <button class="accent-btn" type="button" aria-label="Accent color" title="Accent color" aria-haspopup="true" aria-expanded="false">
                            <span class="current-dot"></span>
                        </button>
                        <div class="palette" role="group" aria-label="Accent color">
                            <template for="accent in data.theme.accents">
                                <button class="swatch" type="button" data-accent="{{ accent.id }}" aria-label="{{ accent.label }}" title="{{ accent.label }}" aria-pressed="false"></button>
                            </template>
                            <label class="custom" title="Custom color">
                                <span class="custom-dot"></span>
                                <span class="custom-text">Custom</span>
                                <input class="custom-input" type="color" value="#01b568" aria-label="Custom accent color">
                            </label>
                        </div>
                    </div>
                    <button class="theme-btn" type="button" aria-label="Switch color theme" title="Switch color theme">
                        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    </button>
                    <button class="menu-btn" type="button" aria-label="Open menu" title="Menu" aria-expanded="false">
                        <svg class="bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                        <svg class="close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="mobile-menu">
            <template for="link in data.nav">
                <a href="{{ link.href }}">{{ link.label }}</a>
            </template>
        </div>
    </nav>
</template>

<style>
    nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--nav-bg);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
    }

    nav .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
    }

    .brand {
        font-family: var(--mono);
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 0.02em;
    }

    .brand span {
        color: var(--accent-ink);
    }

    .right {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .links {
        display: flex;
        gap: 22px;
    }

    .links a {
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
    }

    .links a:hover {
        color: var(--text);
    }

    .tools {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .picker {
        position: relative;
    }

    .accent-btn,
    .theme-btn,
    .menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
    }

    .accent-btn:hover,
    .theme-btn:hover,
    .menu-btn:hover {
        color: var(--text);
        border-color: var(--muted);
    }

    .current-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--a-fill);
    }

    .theme-btn svg,
    .menu-btn svg {
        width: 18px;
        height: 18px;
    }

    .palette {
        display: none;
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        grid-template-columns: repeat(3, 1fr);
        justify-items: center;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }

    .palette.open {
        display: grid;
    }

    .swatch {
        width: 26px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: var(--a-fill);
        cursor: pointer;
    }

    .swatch[aria-pressed='true'] {
        outline: 2px solid var(--text);
        outline-offset: 2px;
    }

    .custom {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        grid-column: 1 / -1;
        justify-self: stretch;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--muted);
        font-size: 13px;
        cursor: pointer;
    }

    .custom:hover {
        color: var(--text);
        border-color: var(--muted);
    }

    .custom.active {
        border-color: var(--accent);
        color: var(--text);
    }

    .custom-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: conic-gradient(#f43f5e, #f59e0b, #10b981, #3b82f6, #a855f7, #f43f5e);
    }

    .custom-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .menu-btn {
        display: none;
    }

    .menu-btn .close,
    .menu-btn[aria-expanded='true'] .bars {
        display: none;
    }

    .menu-btn[aria-expanded='true'] .close {
        display: block;
    }

    .mobile-menu {
        display: none;
    }

    @media (max-width: 760px) {
        .links {
            display: none;
        }

        .right {
            gap: 0;
        }

        .menu-btn {
            display: inline-flex;
        }

        .mobile-menu.open {
            display: flex;
            flex-direction: column;
            padding: 8px 24px 16px;
            border-top: 1px solid var(--line);
            background: var(--panel);
        }

        .mobile-menu a {
            padding: 12px 0;
            border-bottom: 1px solid var(--line);
            color: var(--text);
            font-size: 15px;
            font-weight: 500;
            text-decoration: none;
        }

        .mobile-menu a:last-child {
            border-bottom: 0;
        }
    }
</style>

<script>
    const root = document.documentElement;
    const accentBtn = $el.querySelector('.accent-btn');
    const palette = $el.querySelector('.palette');
    const swatches = $el.querySelectorAll('.swatch');
    const menuBtn = $el.querySelector('.menu-btn');
    const menu = $el.querySelector('.mobile-menu');
    const customLabel = $el.querySelector('.custom');
    const customInput = $el.querySelector('.custom-input');

    const lightBg = [244, 247, 251];

    function encode(value) {
        const clamped = Math.min(1, Math.max(0, value));
        const gamma = clamped <= 0.0031308 ? 12.92 * clamped : 1.055 * Math.pow(clamped, 1 / 2.4) - 0.055;
        return Math.round(gamma * 255);
    }

    function decode(channel) {
        const value = channel / 255;
        return value <= 0.04045 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
    }

    function toRgb(lightness, chroma, hue) {
        let c = chroma;
        let linear;
        for (;;) {
            const a = c * Math.cos((hue * Math.PI) / 180);
            const b = c * Math.sin((hue * Math.PI) / 180);
            const l = Math.pow(lightness + 0.3963377774 * a + 0.2158037573 * b, 3);
            const m = Math.pow(lightness - 0.1055613458 * a - 0.0638541728 * b, 3);
            const s = Math.pow(lightness - 0.0894841775 * a - 1.291485548 * b, 3);
            linear = [
                4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
            ];
            const inside = linear.every((v) => v >= -0.0001 && v <= 1.0001);
            if (inside || c <= 0) break;
            c -= 0.002;
        }
        return linear.map(encode);
    }

    function toOklch(hex) {
        const r = decode(parseInt(hex.slice(1, 3), 16));
        const g = decode(parseInt(hex.slice(3, 5), 16));
        const b = decode(parseInt(hex.slice(5, 7), 16));
        const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
        const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
        const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
        const lightness = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
        const a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
        const bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
        const hue = (Math.atan2(bb, a) * 180) / Math.PI;
        return { lightness, chroma: Math.hypot(a, bb), hue: hue < 0 ? hue + 360 : hue };
    }

    function luminance(rgb) {
        const [r, g, b] = rgb.map(decode);
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    }

    function contrast(first, second) {
        const a = luminance(first);
        const b = luminance(second);
        return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
    }

    function toHex(rgb) {
        return '#' + rgb.map((v) => v.toString(16).padStart(2, '0')).join('');
    }

    function darkenUntil(chroma, hue, start, background, minimum, floor) {
        let lightness = start;
        let rgb = toRgb(lightness, chroma, hue);
        while (contrast(rgb, background) < minimum && lightness > floor) {
            lightness -= 0.01;
            rgb = toRgb(lightness, chroma, hue);
        }
        return rgb;
    }

    function buildCustom(hex) {
        const base = toOklch(hex);
        const hue = base.hue;
        const fill = toRgb(Math.min(0.8, Math.max(0.6, base.lightness)), Math.min(0.21, base.chroma), hue);
        const onText = darkenUntil(0.04, hue, 0.2, fill, 6.5, 0.05);
        const inkLight = darkenUntil(Math.min(0.17, base.chroma), hue, 0.5, lightBg, 5.5, 0.3);
        const tintLight = darkenUntil(Math.min(0.12, base.chroma), hue, 0.38, lightBg, 8, 0.2);
        return {
            '--a-fill': toHex(fill),
            '--a-rgb': fill.join(', '),
            '--a-on': toHex(onText),
            '--a-ink-d': toHex(toRgb(0.77, Math.min(0.16, base.chroma), hue)),
            '--a-ink-l': toHex(inkLight),
            '--a-tint-d': toHex(toRgb(0.9, Math.min(0.07, base.chroma), hue)),
            '--a-tint-l': toHex(tintLight),
        };
    }

    function clearCustom() {
        ['--a-fill', '--a-rgb', '--a-on', '--a-ink-d', '--a-ink-l', '--a-tint-d', '--a-tint-l'].forEach((name) => {
            root.style.removeProperty(name);
        });
    }

    function save(key, value) {
        try {
            localStorage.setItem(key, value);
        } catch (error) {}
    }

    function setPalette(open) {
        palette.classList.toggle('open', open);
        accentBtn.setAttribute('aria-expanded', String(open));
    }

    function setMenu(open) {
        menu.classList.toggle('open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    function markActive() {
        swatches.forEach((swatch) => {
            const active = swatch.dataset.accent === root.dataset.accent;
            swatch.setAttribute('aria-pressed', String(active));
        });
        customLabel.classList.toggle('active', root.dataset.accent === 'custom');
    }

    accentBtn.addEventListener('click', () => {
        setPalette(!palette.classList.contains('open'));
        setMenu(false);
    });

    swatches.forEach((swatch) => {
        swatch.addEventListener('click', () => {
            clearCustom();
            root.dataset.accent = swatch.dataset.accent;
            save('accent', swatch.dataset.accent);
            markActive();
            setPalette(false);
        });
    });

    customInput.addEventListener('input', () => {
        const vars = buildCustom(customInput.value);
        Object.keys(vars).forEach((name) => root.style.setProperty(name, vars[name]));
        root.dataset.accent = 'custom';
        save('accent', 'custom');
        save('accent-custom', JSON.stringify(vars));
        save('accent-custom-hex', customInput.value);
        markActive();
    });

    try {
        const savedHex = localStorage.getItem('accent-custom-hex');
        if (savedHex) customInput.value = savedHex;
    } catch (error) {}

    $el.querySelector('.theme-btn').addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        save('theme', next);
    });

    menuBtn.addEventListener('click', () => {
        setMenu(!menu.classList.contains('open'));
        setPalette(false);
    });

    menu.addEventListener('click', (event) => {
        if (event.target.closest('a')) setMenu(false);
    });

    document.addEventListener('click', (event) => {
        if (!$el.contains(event.target)) {
            setPalette(false);
            setMenu(false);
        } else if (!event.target.closest('.picker')) {
            setPalette(false);
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            setPalette(false);
            setMenu(false);
        }
    });

    markActive();
</script>
