<template>
    <section id="experience">
        <div class="wrap">
            <div class="sec-head"><span class="num">02</span><h2>Experience</h2></div>

            <div class="panel company">
                <div class="company-head">
                    <h3>{{ data.experience.company.name }}</h3>
                    <span class="meta">{{ data.experience.company.meta }}</span>
                </div>
                <div class="timeline">
                    <template for="role in data.experience.company.roles">
                        <div class="role-item {{ role.current ? 'current' : '' }}">
                            <h4>{{ role.title }}</h4>
                            <span class="meta">{{ role.period }}</span>
                            <ul class="dots">
                                <template for="point in role.points">
                                    <li>{{ point }}</li>
                                </template>
                            </ul>
                        </div>
                    </template>
                </div>
            </div>

            <div class="grid3">
                <template for="venture in data.experience.ventures">
                    <div class="panel mini">
                        <span class="tag">{{ venture.tag }}</span>
                        <h3>{{ venture.name }}</h3>
                        <span class="meta">{{ venture.period }}</span>
                        <ul class="dots">
                            <template for="point in venture.points">
                                <li>{{ point }}</li>
                            </template>
                        </ul>
                    </div>
                </template>
            </div>

            <div class="panel mini volunteer">
                <div class="vol-head">
                    <span class="tag">{{ data.experience.volunteer.tag }}</span>
                    <h3>{{ data.experience.volunteer.title }}</h3>
                    <span class="vol-org">{{ data.experience.volunteer.org }}</span>
                    <span class="meta">{{ data.experience.volunteer.period }}</span>
                </div>
                <div class="vol-body">
                    <ul class="dots">
                        <template for="point in data.experience.volunteer.points">
                            <li>
                                <template if="point.linkHref">{{ point.before }}<a class="vol-link" href="{{ point.linkHref }}" target="_blank" rel="noopener">{{ point.linkLabel }}</a>{{ point.after }}</template>
                                <template else>{{ point.text }}</template>
                            </li>
                        </template>
                    </ul>
                    <ul class="chips">
                        <template for="tech in data.experience.volunteer.stack">
                            <li>{{ tech }}</li>
                        </template>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</template>

<style>
    .company {
        margin-bottom: 22px;
    }

    .company-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 6px 16px;
        margin-bottom: 6px;
    }

    .company-head h3 {
        margin: 0;
        font-size: 20px;
    }

    .meta {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--muted);
    }

    .timeline {
        position: relative;
        margin: 18px 0 0 6px;
        padding-left: 24px;
        border-left: 2px solid var(--line);
    }

    .role-item {
        position: relative;
        padding-bottom: 24px;
    }

    .role-item:last-child {
        padding-bottom: 0;
    }

    .role-item::before {
        content: '';
        position: absolute;
        left: -31px;
        top: 7px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--bg);
        border: 2px solid var(--muted);
    }

    .role-item.current::before {
        border-color: var(--accent);
        background: var(--accent);
    }

    .role-item h4 {
        margin: 0;
        font-size: 16px;
    }

    .role-item .meta {
        display: block;
        margin: 2px 0 8px;
    }

    ul.dots {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    ul.dots li {
        position: relative;
        padding-left: 18px;
        color: var(--text-soft);
        font-size: 15px;
        margin-bottom: 4px;
    }

    ul.dots li::before {
        content: '▸';
        position: absolute;
        left: 0;
        color: var(--accent-ink);
        font-size: 12px;
        top: 3px;
    }

    .mini h3 {
        margin: 0 0 2px;
        font-size: 17px;
    }

    .mini p {
        margin: 10px 0 0;
        color: var(--text-soft);
        font-size: 15px;
    }

    .volunteer {
        margin-top: 16px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
        gap: 12px 40px;
        align-items: start;
        border-left: 3px solid var(--accent);
    }

    .vol-org {
        display: block;
        margin-top: 2px;
        font-size: 15px;
        color: var(--muted);
    }

    .vol-body .dots {
        margin: 0 0 16px;
    }

    .vol-link {
        display: inline-block;
        padding: 0 8px;
        border-radius: 6px;
        background: var(--accent-soft);
        color: var(--accent-tint);
        font-weight: 600;
        text-decoration: none;
    }

    .vol-link:hover {
        background: var(--accent-line);
    }

    .chips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chips li {
        font-family: var(--mono);
        font-size: 13px;
        padding: 4px 10px;
        border-radius: 999px;
        background: var(--bg2);
        border: 1px solid var(--line);
        color: var(--accent-tint);
    }

    @media (max-width: 600px) {
        .volunteer {
            grid-template-columns: minmax(0, 1fr);
            gap: 8px;
        }

        .meta {
            font-size: 14px;
        }
        .role-item h4 {
            font-size: 17px;
        }
        .mini p,
        ul.dots li {
            font-size: 16px;
        }
    }
</style>
