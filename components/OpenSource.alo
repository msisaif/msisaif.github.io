<template>
    <section id="open-source">
        <div class="wrap">
            <div class="sec-head"><span class="num">03</span><h2>Open source</h2></div>
            <template for="group in data.openSource.groups">
                <div class="grp">
                    <template if="group.title">
                        <div class="grp-head">
                            <h3>
                                <template for="part in group.title">
                                    <span class="{{ part.brand ? 'brand-bkash' : '' }}">{{ part.text }}</span>
                                </template>
                            </h3>
                            <p>{{ group.intro }}</p>
                        </div>
                    </template>
                    <template if="group.meta">
                        <div class="meta">
                            <template for="chip in group.meta">
                                <span class="{{ chip.highlight ? 'hl' : '' }}">{{ chip.text }}</span>
                            </template>
                        </div>
                    </template>
                    <div class="items cols-{{ group.cols }}">
                        <template for="item in group.items">
                            <div class="panel item">
                                <div class="item-top">
                                    <h4 lang="{{ item.lang }}">{{ item.name }}</h4>
                                    <span class="req">{{ item.requires }}</span>
                                </div>
                                <template if="item.description">
                                    <p class="desc">{{ item.description }}</p>
                                </template>
                                <template if="item.points">
                                    <ul class="dots">
                                        <template for="point in item.points">
                                            <li>{{ point }}</li>
                                        </template>
                                    </ul>
                                </template>
                                <template if="item.command">
                                    <div class="cmd">
                                        <code>{{ item.command }}</code>
                                        <button class="copy" type="button" data-copy="{{ item.command }}" aria-label="Copy install command"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
                                    </div>
                                </template>
                                <div class="item-foot">
                                    <span class="since">{{ item.since }}</span>
                                    <div class="lnks">
                                        <template for="link in item.links">
                                            <a href="{{ link.href }}" target="_blank" rel="noopener">{{ link.label }}</a>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </template>
            <p class="note">{{ data.openSource.noteBefore }}<a href="{{ data.openSource.noteLinkHref }}" target="_blank" rel="noopener">{{ data.openSource.noteLinkLabel }}</a>.</p>
        </div>
    </section>
</template>

<style>
    .grp {
        margin-top: 36px;
    }

    .grp:first-of-type {
        margin-top: 0;
    }

    .grp-head {
        margin-bottom: 14px;
    }

    .grp-head h3 {
        margin: 0 0 2px;
        font-size: 20px;
        color: var(--text);
    }

    .grp-head p {
        margin: 0;
        font-size: 14px;
        color: var(--dim);
    }

    .brand-bkash {
        color: #e2136e;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 14px;
    }

    .meta span {
        font-size: 15px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--bg2);
        border: 1px solid var(--line);
        color: var(--muted);
    }

    .meta span.hl {
        border-color: var(--accent-line);
        background: var(--accent-soft);
        color: var(--accent-tint);
    }

    .items {
        display: grid;
        gap: 24px;
    }

    .cols-1 {
        grid-template-columns: minmax(0, 1fr);
    }

    .cols-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cols-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .item {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 260px;
    }

    .item-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 4px 12px;
        margin-bottom: 8px;
    }

    .item h4 {
        margin: 0;
        font-size: 19px;
    }

    .req {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--muted);
    }

    .desc {
        margin: 0 0 14px;
        color: var(--text-soft);
        font-size: 16px;
    }

    .dots {
        margin: 0 0 14px;
        padding: 0;
        list-style: none;
    }

    .dots li {
        position: relative;
        padding-left: 18px;
        color: var(--text-soft);
        font-size: 15px;
        margin-bottom: 4px;
    }

    .dots li::before {
        content: '▸';
        position: absolute;
        left: 0;
        top: 3px;
        font-size: 12px;
        color: var(--accent-ink);
    }

    .cmd {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 6px 6px 6px 12px;
        margin-bottom: 14px;
    }

    .cmd code {
        flex: 1;
        min-width: 0;
        font-family: var(--mono);
        font-size: 14px;
        color: var(--accent-tint);
        overflow-x: auto;
        white-space: nowrap;
        padding: 6px 0;
    }

    .cmd code::before {
        content: '$ ';
        color: var(--dim);
    }

    .copy {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        background: var(--bg2);
        color: var(--text);
        border: 1px solid var(--line);
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }

    .copy:hover {
        border-color: var(--accent-line);
        color: var(--accent-tint);
    }

    .copy svg {
        width: 16px;
        height: 16px;
    }

    .copy.ok {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--on-accent);
    }

    .item-foot {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 4px 12px;
    }

    .since {
        font-size: 13px;
        color: var(--dim);
    }

    .lnks {
        display: flex;
        gap: 16px;
        margin-left: auto;
        font-size: 14px;
        font-weight: 600;
    }

    .lnks a {
        text-decoration: none;
        color: var(--accent-tint);
    }

    .lnks a:hover {
        text-decoration: underline;
    }

    @media (hover: hover) and (min-width: 901px) {
        .item {
            transition: transform 0.2s, border-color 0.2s;
        }

        .item:hover {
            transform: translateY(-3px);
            border-color: var(--accent-line);
        }
    }

    .note {
        font-size: 13px;
        color: var(--dim);
        margin-top: 28px;
    }

    @media (max-width: 900px) {
        .cols-2,
        .cols-3 {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (min-width: 601px) and (max-width: 900px) {
        .item h4 {
            font-size: 18px;
        }

        .desc {
            font-size: 15px;
        }

        .meta span {
            font-size: 13px;
        }

        .req {
            font-size: 12px;
        }

        .cmd code {
            font-size: 13px;
        }

        .lnks {
            font-size: 13px;
        }
    }

    @media (max-width: 600px) {
        .item {
            padding: 20px;
            min-height: auto;
        }

        .items {
            gap: 16px;
        }

        .cmd {
            gap: 6px;
            padding: 4px 4px 4px 10px;
        }

        .copy {
            width: 28px;
            height: 28px;
        }

        .copy svg {
            width: 14px;
            height: 14px;
        }
    }

    @media (max-width: 600px) {
        .grp-head p {
            font-size: 15px;
        }
        .lnks {
            font-size: 12px;
        }
        .meta span,
        .req {
            font-size: 13px;
        }
        .desc {
            font-size: 14px;
        }
        .dots li {
            font-size: 16px;
        }
        .cmd code {
            font-size: 12px;
        }
        .since {
            font-size: 12px;
        }
        .note {
            font-size: 14px;
        }
        .item h4 {
            font-size: 18px;
        }
    }
</style>

<script>
    function fallbackCopy(text) {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
            document.execCommand('copy');
        } catch (e) {}
        document.body.removeChild(area);
    }

    const copyIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const checkIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;

    function showCopied(button) {
        button.innerHTML = checkIcon;
        button.classList.add('ok');
        setTimeout(() => {
            button.innerHTML = copyIcon;
            button.classList.remove('ok');
        }, 1600);
    }

    $el.querySelectorAll('.copy').forEach((button) => {
        button.addEventListener('click', () => {
            const text = button.getAttribute('data-copy');
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(() => showCopied(button), () => {
                    fallbackCopy(text);
                    showCopied(button);
                });
            } else {
                fallbackCopy(text);
                showCopied(button);
            }
        });
    });
</script>
