<head>
    <title>ব্লগ | {{ data.site.name }}</title>
</head>

<template>
    <p class="eyebrow">ব্লগ</p>
    <h1>সব লেখা</h1>
    <div class="list">
        <template for="post in data.blog.toReversed()">
            <Card title="{{ post.title }}">
                <p class="meta">
                    <time datetime="{{ post.date }}">{{ new Date(post.date).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) }}</time>
                    · <a href="/blog/{{ post.slug }}/">পড়ুন →</a>
                </p>
            </Card>
        </template>
    </div>
</template>

<style>
    h1 {
        margin-block: 0.4rem 2rem;
        font-size: clamp(2rem, 5vw, 2.6rem);
    }

    .list {
        display: grid;
        gap: 1rem;
        max-width: var(--reading);
    }

    .meta {
        color: var(--muted);
        font-size: 0.92rem;
    }
</style>
